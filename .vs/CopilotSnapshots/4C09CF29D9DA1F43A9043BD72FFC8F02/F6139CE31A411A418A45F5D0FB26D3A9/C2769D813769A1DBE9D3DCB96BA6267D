function applyFilters(data, filters) {
  let result = [...data]
  filters.forEach(f => {
    if (f.type === 'eq') result = result.filter(item => item[f.column] === f.value)
    if (f.type === 'in') result = result.filter(item => f.value.includes(item[f.column]))
    if (f.type === 'or') result = result // simplified - return all for OR
    if (f.type === 'gte') result = result.filter(item => item[f.column] >= f.value)
    if (f.type === 'lte') result = result.filter(item => item[f.column] <= f.value)
  })
  return result
}

function createQueryBuilder(table) {
  let filters = []
  let selectColumns = '*'
  let orderCol = null
  let orderAsc = true
  let limitCount = null
  let singleResult = false

  const builder = {
    select(cols) { selectColumns = cols; return builder },
    eq(col, val) { filters.push({ type: 'eq', column: col, value: val }); return builder },
    in(col, val) { filters.push({ type: 'in', column: col, value: val }); return builder },
    or(expr) { return builder },
    gte(col, val) { filters.push({ type: 'gte', column: col, value: val }); return builder },
    lte(col, val) { filters.push({ type: 'lte', column: col, value: val }); return builder },
    order(col, opts) { orderCol = col; orderAsc = opts?.ascending ?? true; return builder },
    limit(n) { limitCount = n; return builder },
    single() { singleResult = true; return builder.then() },
    then(resolve, reject) {
      const promise = new Promise((res) => {
        let data = mockData[table] ? applyFilters(mockData[table], filters) : []
        if (orderCol) {
          data.sort((a, b) => {
            if (orderAsc) return a[orderCol] > b[orderCol] ? 1 : -1
            return a[orderCol] < b[orderCol] ? 1 : -1
          })
        }
        if (limitCount) data = data.slice(0, limitCount)

        // Handle joins in select (e.g., "*, profiles(full_name)")
        if (selectColumns.includes('profiles(')) {
          data = data.map(item => ({
            ...item,
            profiles: mockData.profiles.find(p => p.id === item.user_id) || { full_name: 'Unknown' }
          }))
        }
        if (selectColumns.includes('salaries(')) {
          data = data.map(item => ({
            ...item,
            salaries: mockData.salaries.filter(s => s.user_id === item.id)
          }))
        }

        if (singleResult) res({ data: data[0] || null, error: null })
        else res({ data, error: null })
      })
      return resolve ? promise.then(resolve, reject) : promise
    },
  }
  return builder
}

export const supabase = {
  from(table) {
    return {
      select(cols) { return createQueryBuilder(table).select(cols || '*') },
      insert(row) {
        const newRow = { id: crypto.randomUUID(), ...row, created_at: new Date().toISOString() }
        if (!mockData[table]) mockData[table] = []
        mockData[table].push(newRow)
        return Promise.resolve({ data: newRow, error: null })
      },
      update(updates) {
        return {
          eq(col, val) {
            const item = mockData[table]?.find(i => i[col] === val)
            if (item) Object.assign(item, updates)
            return Promise.resolve({ data: item, error: null })
          }
        }
      },
    }
  },
  auth: {
    getSession() {
      const stored = localStorage.getItem('mock_user')
      if (stored) {
        const user = JSON.parse(stored)
        return Promise.resolve({ data: { session: { user } } })
      }
      return Promise.resolve({ data: { session: null } })
    },
    onAuthStateChange(callback) {
      return { data: { subscription: { unsubscribe() {} } } }
    },
    signUp({ email, password }) {
      const role = email.includes('manager') ? 'manager' : email.includes('owner') ? 'owner' : email.includes('labor') ? 'labor' : 'worker'
      const user = { id: crypto.randomUUID(), email }
      return Promise.resolve({ data: { user }, error: null })
    },
    signInWithPassword({ email, password }) {
      // Find matching mock profile or create one based on email
      let profile = mockData.profiles.find(p => p.email === email)
      if (!profile) {
        profile = mockData.profiles[0] // Default to worker
      }
      const user = { id: profile.id, email: profile.email }
      localStorage.setItem('mock_user', JSON.stringify(user))
      return Promise.resolve({ data: { user, session: { user } }, error: null })
    },
    signOut() {
      localStorage.removeItem('mock_user')
      return Promise.resolve({})
    },
  },
}
